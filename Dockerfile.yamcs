# SHIRE YAMCS Base Dockerfile
# Build environment for SHIRE ground software (YAMCS).
# Published to: ghcr.io/voyagertechnologies-public/shire-yamcs
#
# Local, native-platform build: make container (from repo root)
#
# Publish a multi-platform image to your own GHCR namespace (from repo root):
#   1. Create a GitHub token with write:packages, then use it as the password for:
#        docker login ghcr.io -u YOUR_GITHUB_USER
#   2. Create and bootstrap a multi-platform builder (one time):
#        docker buildx create --name shire-multiarch --driver docker-container --use
#        docker buildx inspect --bootstrap
#   3. Build and push the image plus its multi-platform manifest:
#        export IMAGE=ghcr.io/voyagertechnologies-public/shire-yamcs
#        docker buildx build --platform linux/amd64,linux/arm64 \
#          --tag "${IMAGE}:0.0.0" --push -f yamcs/Dockerfile.yamcs yamcs
#   4. Verify the published platforms:
#        docker buildx imagetools inspect "${IMAGE}:0.0.0"
#

FROM maven:3.9.16-eclipse-temurin-17-noble@sha256:1a352420f7aba21f5ad08df31bab55f74c013fb491f1ae8ab1dd7ff9ed698584

LABEL org.opencontainers.image.title="shire-yamcs" \
      org.opencontainers.image.description="Build environment for SHIRE YAMCS ground software" \
      org.opencontainers.image.source="https://github.com/VoyagerTechnologies-public/shire" \
      org.opencontainers.image.vendor="Voyager Technologies"

WORKDIR /app

# Copy Maven wrapper and POM before source so dependency layer is cached independently
COPY pom.xml ./
COPY mvnw mvnw.cmd ./
COPY .mvn .mvn/

# Pre-fetch Maven dependencies so builds don't re-download on every run
RUN mvn dependency:go-offline -B && cp pom.xml /baseline-pom.xml
