# SHIRE YAMCS GSW with offline Cesium visualization.
FROM node:22-bookworm-slim AS viewer
WORKDIR /viewer
COPY visualization/package*.json ./
RUN npm ci
COPY visualization/ ./
COPY --from=visual-assets /earth-imagery.* /viewer/public/
COPY --from=visual-assets /model.glb /viewer/public/model.glb
COPY --from=visual-assets /model-asset.json /viewer/public/model-asset.json
RUN npm run build

#

FROM ghcr.io/voyagertechnologies-public/shire-yamcs:0.0.0 AS builder
WORKDIR /app

# Copy files
COPY pom.xml mvnw mvnw.cmd ./
COPY .mvn .mvn/
COPY src/ src/

# Build the application
RUN mvn clean package -DskipTests

# Runtime stage - base from your lab/build image
FROM ghcr.io/voyagertechnologies-public/shire-yamcs:0.0.0
WORKDIR /app

# Copy the built application from builder stage
COPY --from=builder /app/target/*-bundle.tar.gz ./
RUN tar -xzf *-bundle.tar.gz --strip-components=1 && rm *-bundle.tar.gz

COPY --from=viewer /viewer/dist/ /app/shire-static/visualization/

# Copy entrypoint and timeline management scripts
COPY bin/entrypoint.sh /app/bin/entrypoint.sh
COPY yamcs_timeline.py /opt/yamcs/yamcs_timeline.py
COPY load_timelines.sh /opt/yamcs/load_timelines.sh
COPY timelines/ /opt/yamcs/timelines/
RUN chmod +x /app/bin/entrypoint.sh /opt/yamcs/yamcs_timeline.py /opt/yamcs/load_timelines.sh

# Expose ports
EXPOSE 8090 10015/udp 10025/udp

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8090 || exit 1

# Start YAMCS (entrypoint already copied and chmod'd as root)
ENTRYPOINT ["/app/bin/entrypoint.sh"]
CMD []
