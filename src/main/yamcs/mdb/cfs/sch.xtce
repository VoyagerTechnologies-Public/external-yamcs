        <xtce:Parameter name="BADTABLEDATACOUNT" parameterTypeRef="BADTABLEDATACOUNT_Type" />
        <xtce:Parameter name="TABLEVERIFYSUCCESSCOUNT" parameterTypeRef="TABLEVERIFYSUCCESSCOUNT_Type" />
        <xtce:Parameter name="TABLEVERIFYFAILURECOUNT" parameterTypeRef="TABLEVERIFYFAILURECOUNT_Type" />
        <xtce:Parameter name="TABLEPASSCOUNT" parameterTypeRef="TABLEPASSCOUNT_Type" />
        <xtce:Parameter name="VALIDMAJORFRAMECOUNT" parameterTypeRef="VALIDMAJORFRAMECOUNT_Type" />
        <xtce:Parameter name="MISSEDMAJORFRAMECOUNT" parameterTypeRef="MISSEDMAJORFRAMECOUNT_Type" />
        <xtce:Parameter name="UNEXPECTEDMAJORFRAMECOUNT" parameterTypeRef="UNEXPECTEDMAJORFRAMECOUNT_Type" />
        <xtce:Parameter name="MINORFRAMESSINCETONE" parameterTypeRef="MINORFRAMESSINCETONE_Type" />
        <xtce:Parameter name="NEXTSLOTNUMBER" parameterTypeRef="NEXTSLOTNUMBER_Type" />
        <xtce:Parameter name="LASTSYNCMETSLOT" parameterTypeRef="LASTSYNCMETSLOT_Type" />
        <xtce:Parameter name="IGNOREMAJORFRAME" parameterTypeRef="IGNOREMAJORFRAME_Type" />
        <xtce:Parameter name="UNEXPECTEDMAJORFRAME" parameterTypeRef="UNEXPECTEDMAJORFRAME_Type" />
      </xtce:ParameterSet>
      <xtce:ContainerSet>
        <xtce:SequenceContainer name="SCH_HKPACKET" shortDescription="Scheduler HK Telemetry format">
          <xtce:EntryList>
            <xtce:ParameterRefEntry parameterRef="CMDCOUNTER" />
            <xtce:ParameterRefEntry parameterRef="ERRCOUNTER" />
            <xtce:ParameterRefEntry parameterRef="SYNCTOMET" />
            <xtce:ParameterRefEntry parameterRef="MAJORFRAMESOURCE" />
            <xtce:ParameterRefEntry parameterRef="SCHEDULEACTIVITYSUCCESSCOUNT" />
            <xtce:ParameterRefEntry parameterRef="SCHEDULEACTIVITYFAILURECOUNT" />
            <xtce:ParameterRefEntry parameterRef="SLOTSPROCESSEDCOUNT" />
            <xtce:ParameterRefEntry parameterRef="SKIPPEDSLOTSCOUNT" />
            <xtce:ParameterRefEntry parameterRef="MULTIPLESLOTSCOUNT" />
            <xtce:ParameterRefEntry parameterRef="SAMESLOTCOUNT" />
            <xtce:ParameterRefEntry parameterRef="BADTABLEDATACOUNT" />
            <xtce:ParameterRefEntry parameterRef="TABLEVERIFYSUCCESSCOUNT" />
            <xtce:ParameterRefEntry parameterRef="TABLEVERIFYFAILURECOUNT" />
            <xtce:ParameterRefEntry parameterRef="TABLEPASSCOUNT" />
            <xtce:ParameterRefEntry parameterRef="VALIDMAJORFRAMECOUNT" />
            <xtce:ParameterRefEntry parameterRef="MISSEDMAJORFRAMECOUNT" />
            <xtce:ParameterRefEntry parameterRef="UNEXPECTEDMAJORFRAMECOUNT" />
            <xtce:ParameterRefEntry parameterRef="MINORFRAMESSINCETONE" />
            <xtce:ParameterRefEntry parameterRef="NEXTSLOTNUMBER" />
            <xtce:ParameterRefEntry parameterRef="LASTSYNCMETSLOT" />
            <xtce:ParameterRefEntry parameterRef="IGNOREMAJORFRAME" />
            <xtce:ParameterRefEntry parameterRef="UNEXPECTEDMAJORFRAME" />
          </xtce:EntryList>
          <xtce:BaseContainer containerRef="/CCSDS/CCSDS_TM">
            <xtce:RestrictionCriteria>
              <xtce:ComparisonList>
                <xtce:Comparison parameterRef="/CCSDS/CCSDS_STREAMID" value="2199" />
              </xtce:ComparisonList>
            </xtce:RestrictionCriteria>
          </xtce:BaseContainer>
        </xtce:SequenceContainer>
      </xtce:ContainerSet>
    </xtce:TelemetryMetaData>
  </xtce:SpaceSystem>
