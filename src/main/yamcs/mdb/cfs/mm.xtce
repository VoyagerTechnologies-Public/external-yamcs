          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="ADDRESS_Type" shortDescription="Fully resolved address used for last command." signed="false">
