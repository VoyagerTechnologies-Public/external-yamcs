<?xml version='1.0' encoding='UTF-8'?>
<xtce:SpaceSystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xtce="http://www.omg.org/spec/XTCE/20180204" name="SC" xsi:schemaLocation="http://www.omg.org/spec/XTCE/20180204 https://www.omg.org/spec/XTCE/20180204/SpaceSystem.xsd">
  <xtce:SpaceSystem name="SC_HKTLM">
    <xtce:TelemetryMetaData>
      <xtce:ParameterTypeSet>
        <xtce:EnumeratedParameterType name="ATSNUMBER_Type" shortDescription="current ATS number 1 = ATS A, 2 = ATS B">
          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
          <xtce:EnumerationList>
            <xtce:Enumeration value="0" label="A" />
            <xtce:Enumeration value="1" label="B" />
          </xtce:EnumerationList>
        </xtce:EnumeratedParameterType>
        <xtce:EnumeratedParameterType name="ATPSTATE_Type" shortDescription="current ATP state valid values are: 2 = IDLE, 5 = EXECUTING">
          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
          <xtce:EnumerationList>
            <xtce:Enumeration value="2" label="IDLE" />
            <xtce:Enumeration value="5" label="EXECUTING" />
          </xtce:EnumerationList>
        </xtce:EnumeratedParameterType>
        <xtce:EnumeratedParameterType name="CONTINUEATSONFAILUREFLAG_Type" shortDescription="In the event of ATS execution failure (ats command fails checksum) , the ATS execution will continue if this flag is set to TRUE and will stop if this flag is set to FALSE.">
          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
          <xtce:EnumerationList>
            <xtce:Enumeration value="0" label="STOP" />
            <xtce:Enumeration value="1" label="CONTINUE" />
          </xtce:EnumerationList>
        </xtce:EnumeratedParameterType>
        <xtce:IntegerParameterType name="CMDERRCTR_Type" shortDescription="Counts Request Errors." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="CMDCTR_Type" shortDescription="Counts Ground Requests." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="PADDING8_Type" shortDescription="" signed="false">
          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
        </xtce:IntegerParameterType>
        <xtce:EnumeratedParameterType name="SWITCHPENDFLAG_Type" shortDescription="is an ats switch pending? 0 = NO, 1 = YES This means that the ATS switch is waiting until a safe time">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
          <xtce:EnumerationList>
            <xtce:Enumeration value="0" label="NO" />
            <xtce:Enumeration value="1" label="YES" />
          </xtce:EnumerationList>
        </xtce:EnumeratedParameterType>
        <xtce:IntegerParameterType name="NUMRTSACTIVE_Type" shortDescription="number of RTSs currently active" signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="RTSNUMBER_Type" shortDescription="next RTS number" signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="RTSACTIVECTR_Type" shortDescription="Increments when an RTS is started without error." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="RTSACTIVEERRCTR_Type" shortDescription="Increments when an attempt to start an RTS fails." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="ATSCMDCTR_Type" shortDescription="Total ATS cmd cnter counts commands sent by the ATS." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="ATSCMDERRCTR_Type" shortDescription="Total ATS cmd Error ctr command errors in the ATS." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="RTSCMDCTR_Type" shortDescription="Counts TOTAL rts cmds that were sent out from ALL active RTSs." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="RTSCMDERRCTR_Type" shortDescription="Counts TOTAL number of errs from ALL RTSs that are active." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="LASTATSERRSEQ_Type" shortDescription="Last ATS Errant Sequence Num Values: 1 or 2." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="LASTATSERRCMD_Type" shortDescription="Last ATS Errant Command Num." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="LASTRTSERRSEQ_Type" shortDescription="Last RTS Errant Sequence Num." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="LASTRTSERRCMD_Type" shortDescription="The OFFSET in the RTS buffer of the command that had an error It will be a WORD value i.e. 1st command had an error, this value would be 0, if the 2nd command started at int8 10 in the buffer, this value would be 5." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="APPENDCMDARG_Type" shortDescription="ATS selection argument from most recent Append ATS command." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="APPENDENTRYCOUNT_Type" shortDescription="Number of cmd entries in current Append ATS table." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="APPENDBYTECOUNT_Type" shortDescription="Size of cmd entries in current Append ATS table." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="APPENDLOADCOUNT_Type" shortDescription="Total number of Append ATS table loads." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="ATPCMDNUMBER_Type" shortDescription="current command number" signed="false">
          <xtce:IntegerDataEncoding sizeInBits="32" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="ATPFREEBYTES_1_Type" shortDescription="Free Bytes in each ATS. byte 1" signed="false">
          <xtce:IntegerDataEncoding sizeInBits="32" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="ATPFREEBYTES_2_Type" shortDescription="Free Bytes in each ATS. byte 2" signed="false">
          <xtce:IntegerDataEncoding sizeInBits="32" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="NEXTRTSTIME_Type" shortDescription="next RTS cmd Absolute Time" signed="false">
          <xtce:IntegerDataEncoding sizeInBits="32" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="NEXTATSTIME_Type" shortDescription="Next ATS Command Time (seconds)." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="32" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="RTSEXECUTINGSTATUS_1_Type" shortDescription="RTS 1-15 Executing Status" signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="RTSDISABLEDSTATUS_1_Type" shortDescription="RTS 1-15 Disabled Status" signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
      </xtce:ParameterTypeSet>
      <xtce:ParameterSet>
