          <xtce:CommandContainer name="CFS_CFE_TBL_VALIDATE_CommandContainer">
            <xtce:EntryList>
              <xtce:ArgumentRefEntry argumentRef="ACTIVETBLFLAG" />
              <xtce:ArgumentRefEntry argumentRef="TABLENAME" />
            </xtce:EntryList>
          </xtce:CommandContainer>
        </xtce:MetaCommand>
        <xtce:MetaCommand name="CFE_TBL_TLM_REG">
          <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
            <xtce:ArgumentAssignmentList>
              <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="6148" />
              <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="7" />
            </xtce:ArgumentAssignmentList>
          </xtce:BaseMetaCommand>
          <xtce:ArgumentList>
            <xtce:Argument name="TABLENAME" argumentTypeRef="TABLENAME_Type" />
