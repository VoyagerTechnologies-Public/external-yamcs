          <xtce:CommandContainer name="CFS_CFE_TBL_TLM_REG_CommandContainer">
            <xtce:EntryList>
              <xtce:ArgumentRefEntry argumentRef="TABLENAME" />
            </xtce:EntryList>
          </xtce:CommandContainer>
        </xtce:MetaCommand>
        <xtce:MetaCommand name="CFE_TBL_RESET">
          <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
            <xtce:ArgumentAssignmentList>
              <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="6148" />
              <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="1" />
            </xtce:ArgumentAssignmentList>
          </xtce:BaseMetaCommand>
          <xtce:ArgumentList />
          <xtce:CommandContainer name="CFS_CFE_TBL_RESET_CommandContainer">
            <xtce:EntryList />
          </xtce:CommandContainer>
        </xtce:MetaCommand>
        <xtce:MetaCommand name="CFE_TBL_NOOP">
          <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
            <xtce:ArgumentAssignmentList>
              <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="6148" />
              <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="0" />
            </xtce:ArgumentAssignmentList>
          </xtce:BaseMetaCommand>
          <xtce:ArgumentList />
          <xtce:CommandContainer name="CFS_CFE_TBL_NOOP_CommandContainer">
            <xtce:EntryList />
          </xtce:CommandContainer>
        </xtce:MetaCommand>
        <xtce:MetaCommand name="CFE_TBL_LOAD">
          <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
            <xtce:ArgumentAssignmentList>
              <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="6148" />
              <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="2" />
            </xtce:ArgumentAssignmentList>
          </xtce:BaseMetaCommand>
          <xtce:ArgumentList>
            <xtce:Argument name="LOADFILENAME" argumentTypeRef="LOADFILENAME_Type" />
          </xtce:ArgumentList>
          <xtce:CommandContainer name="CFS_CFE_TBL_LOAD_CommandContainer">
            <xtce:EntryList>
              <xtce:ArgumentRefEntry argumentRef="LOADFILENAME" />
            </xtce:EntryList>
          </xtce:CommandContainer>
        </xtce:MetaCommand>
        <xtce:MetaCommand name="CFE_TBL_DUMP_REG">
          <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
            <xtce:ArgumentAssignmentList>
              <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="6148" />
              <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="6" />
            </xtce:ArgumentAssignmentList>
          </xtce:BaseMetaCommand>
          <xtce:ArgumentList>
            <xtce:Argument name="DUMPFILENAME" argumentTypeRef="DUMPFILENAME_Type" />
          </xtce:ArgumentList>
          <xtce:CommandContainer name="CFS_CFE_TBL_DUMP_REG_CommandContainer">
            <xtce:EntryList>
              <xtce:ArgumentRefEntry argumentRef="DUMPFILENAME" />
            </xtce:EntryList>
          </xtce:CommandContainer>
