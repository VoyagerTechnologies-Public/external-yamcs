<?xml version='1.0' encoding='UTF-8'?>
<xtce:SpaceSystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xtce="http://www.omg.org/spec/XTCE/20180204" name="CFE_SB" xsi:schemaLocation="http://www.omg.org/spec/XTCE/20180204 https://www.omg.org/spec/XTCE/20180204/SpaceSystem.xsd">
  <xtce:SpaceSystem name="CFE_SB_SUBRPRTMSG">
    <xtce:TelemetryMetaData>
      <xtce:ParameterTypeSet>
        <xtce:IntegerParameterType name="SUBTYPE_Type" shortDescription="Subscription or Unsubscription." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="ALIGNMENT_PADDING1_Type" shortDescription="Native structure alignment padding." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="24" encoding="unsigned" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="MSGID_Type" shortDescription="MsgId subscribed or unsubscribe to." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="32" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="QOS_PRIORITY_Type" shortDescription="Specify high(1) or low(0) message priority for off-board routing, currently unused. (Parent: Quality of Service, used only for interprocessor communication.)" signed="false">
          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="QOS_RELIABILITY_Type" shortDescription="Specify high(1) or low(0) message transfer reliability for off-board routing, currently unused. (Parent: Quality of Service, used only for interprocessor communication.)" signed="false">
          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="PIPE_Type" shortDescription="Destination pipe id to send above msg id." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="32" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="ALIGNMENT_PADDING2_Type" shortDescription="Native structure alignment padding." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" />
        </xtce:IntegerParameterType>
      </xtce:ParameterTypeSet>
      <xtce:ParameterSet>
        <xtce:Parameter name="SUBTYPE" parameterTypeRef="SUBTYPE_Type" />
        <xtce:Parameter name="ALIGNMENT_PADDING1" parameterTypeRef="ALIGNMENT_PADDING1_Type" />
        <xtce:Parameter name="MSGID" parameterTypeRef="MSGID_Type" />
        <xtce:Parameter name="QOS_PRIORITY" parameterTypeRef="QOS_PRIORITY_Type" />
        <xtce:Parameter name="QOS_RELIABILITY" parameterTypeRef="QOS_RELIABILITY_Type" />
        <xtce:Parameter name="ALIGNMENT_PADDING2" parameterTypeRef="ALIGNMENT_PADDING2_Type" />
        <xtce:Parameter name="PIPE" parameterTypeRef="PIPE_Type" />
      </xtce:ParameterSet>
      <xtce:ContainerSet>
        <xtce:SequenceContainer name="CFE_SB_SUBRPRTMSG" shortDescription="SB Subscription Report Packet">
          <xtce:EntryList>
            <xtce:ParameterRefEntry parameterRef="SUBTYPE" />
            <xtce:ParameterRefEntry parameterRef="ALIGNMENT_PADDING1" />
            <xtce:ParameterRefEntry parameterRef="MSGID" />
            <xtce:ParameterRefEntry parameterRef="QOS_PRIORITY" />
            <xtce:ParameterRefEntry parameterRef="QOS_RELIABILITY" />
            <xtce:ParameterRefEntry parameterRef="ALIGNMENT_PADDING2" />
            <xtce:ParameterRefEntry parameterRef="PIPE" />
          </xtce:EntryList>
          <xtce:BaseContainer containerRef="/CCSDS/CCSDS_TM">
            <xtce:RestrictionCriteria>
              <xtce:ComparisonList>
                <xtce:Comparison parameterRef="/CCSDS/CCSDS_STREAMID" value="2062" />
              </xtce:ComparisonList>
            </xtce:RestrictionCriteria>
          </xtce:BaseContainer>
        </xtce:SequenceContainer>
      </xtce:ContainerSet>
    </xtce:TelemetryMetaData>
  </xtce:SpaceSystem>
