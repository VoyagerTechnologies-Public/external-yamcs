<?xml version='1.0' encoding='UTF-8'?>
<xtce:SpaceSystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xtce="http://www.omg.org/spec/XTCE/20180204" name="HK" xsi:schemaLocation="http://www.omg.org/spec/XTCE/20180204 https://www.omg.org/spec/XTCE/20180204/SpaceSystem.xsd">
  <xtce:SpaceSystem name="HK_HKPACKET">
    <xtce:TelemetryMetaData>
      <xtce:ParameterTypeSet>
        <xtce:IntegerParameterType name="CMDCOUNTER_Type" shortDescription="Count of valid commands received." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="ERRCOUNTER_Type" shortDescription="Count of invalid commands received." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="PADDING_Type" shortDescription="Padding to force 32 bit alignment." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="COMBINEDPACKETSSENT_Type" shortDescription="Count of combined tlm pkts sent." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="MISSINGDATACTR_Type" shortDescription="Number of times missing data was detected." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
        <xtce:IntegerParameterType name="MEMPOOLHANDLE_Type" shortDescription="Memory pool handle used to get mempool diags." signed="false">
          <xtce:IntegerDataEncoding sizeInBits="32" encoding="unsigned" byteOrder="leastSignificantByteFirst" />
        </xtce:IntegerParameterType>
      </xtce:ParameterTypeSet>
      <xtce:ParameterSet>
        <xtce:Parameter name="CMDCOUNTER" parameterTypeRef="CMDCOUNTER_Type" />
        <xtce:Parameter name="ERRCOUNTER" parameterTypeRef="ERRCOUNTER_Type" />
        <xtce:Parameter name="PADDING" parameterTypeRef="PADDING_Type" />
        <xtce:Parameter name="COMBINEDPACKETSSENT" parameterTypeRef="COMBINEDPACKETSSENT_Type" />
        <xtce:Parameter name="MISSINGDATACTR" parameterTypeRef="MISSINGDATACTR_Type" />
        <xtce:Parameter name="MEMPOOLHANDLE" parameterTypeRef="MEMPOOLHANDLE_Type" />
      </xtce:ParameterSet>
      <xtce:ContainerSet>
        <xtce:SequenceContainer name="HK_HKPACKET" shortDescription="HK Application housekeeping Packet">
          <xtce:EntryList>
            <xtce:ParameterRefEntry parameterRef="CMDCOUNTER" />
            <xtce:ParameterRefEntry parameterRef="ERRCOUNTER" />
            <xtce:ParameterRefEntry parameterRef="PADDING" />
            <xtce:ParameterRefEntry parameterRef="COMBINEDPACKETSSENT" />
            <xtce:ParameterRefEntry parameterRef="MISSINGDATACTR" />
            <xtce:ParameterRefEntry parameterRef="MEMPOOLHANDLE" />
          </xtce:EntryList>
          <xtce:BaseContainer containerRef="/CCSDS/CCSDS_TM">
            <xtce:RestrictionCriteria>
              <xtce:ComparisonList>
                <xtce:Comparison parameterRef="/CCSDS/CCSDS_STREAMID" value="2203" />
              </xtce:ComparisonList>
            </xtce:RestrictionCriteria>
          </xtce:BaseContainer>
        </xtce:SequenceContainer>
      </xtce:ContainerSet>
    </xtce:TelemetryMetaData>
  </xtce:SpaceSystem>
  <xtce:SpaceSystem name="HK_COMMANDS">
    <xtce:CommandMetaData>
      <xtce:ArgumentTypeSet />
      <xtce:MetaCommandSet>
        <xtce:MetaCommand name="HK_RESET">
          <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
            <xtce:ArgumentAssignmentList>
              <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="6298" />
              <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="1" />
            </xtce:ArgumentAssignmentList>
          </xtce:BaseMetaCommand>
          <xtce:ArgumentList />
          <xtce:CommandContainer name="CFS_HK_RESET_CommandContainer">
            <xtce:EntryList />
          </xtce:CommandContainer>
        </xtce:MetaCommand>
        <xtce:MetaCommand name="HK_NOOP">
          <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
            <xtce:ArgumentAssignmentList>
              <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="6298" />
              <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="0" />
            </xtce:ArgumentAssignmentList>
          </xtce:BaseMetaCommand>
          <xtce:ArgumentList />
          <xtce:CommandContainer name="CFS_HK_NOOP_CommandContainer">
            <xtce:EntryList />
          </xtce:CommandContainer>
        </xtce:MetaCommand>
      </xtce:MetaCommandSet>
    </xtce:CommandMetaData>
  </xtce:SpaceSystem>
</xtce:SpaceSystem>
