# Yamcs runtime dependencies; no build tools or source code.
# Local native-platform build: make container (from repo root)
# Published to: ghcr.io/voyagertechnologies-public/shire-yamcs-runtime
#
# Manual multi-platform GHCR publish (from repo root):
#   1. Create a classic GitHub token with write:packages and permission to
#      publish to VoyagerTechnologies-Public. Authorize SSO if required.
#   2. Set CR_PAT in your shell, then log in:
#        printf '%s' "$CR_PAT" | docker login ghcr.io -u YOUR_GITHUB_USER --password-stdin
#   3. Create and bootstrap a multi-platform builder (one time):
#        docker buildx create --name shire-multiarch --driver docker-container --use
#        docker buildx inspect --bootstrap
#   4. Build and push the image plus its multi-platform manifest:
#        export IMAGE=ghcr.io/voyagertechnologies-public/shire-yamcs-runtime
#        docker buildx build --platform linux/amd64,linux/arm64 \
#          --tag "${IMAGE}:0.0.0" --push -f yamcs/Dockerfile.runtime-base yamcs
#   5. Verify the published platforms:
#        docker buildx imagetools inspect "${IMAGE}:0.0.0"
#
FROM eclipse-temurin:17-jre-noble@sha256:d1b6f76d8112c41f1068597741f0c0bda36d323365078e685381f72e5ec51ca0
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl python3 python3-requests && rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.title="shire-yamcs-runtime" \
      org.opencontainers.image.description="Runtime dependencies for SHIRE Yamcs ground software" \
      org.opencontainers.image.source="https://github.com/VoyagerTechnologies-Public/shire" \
      org.opencontainers.image.vendor="Voyager Technologies"
